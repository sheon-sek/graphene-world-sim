{
  "name": "@gws/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "api:gen": "openapi-typescript ../../docs/api/openapi.json -o src/api/schema.d.ts --default-non-nullable false",
    "api:check": "openapi-typescript ../../docs/api/openapi.json -o src/api/schema.d.ts --default-non-nullable false --check",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "@xyflow/react": "12.9.0",
    "camera-controls": "3.1.2",
    "openapi-fetch": "0.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.1",
    "uplot": "1.6.32",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "7.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
